<?xml version="1.0" encoding="utf-8"?>
<!-- 只进 debug 包：小部件设计预览（假数据）与从电脑触发刷新 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".WidgetPreviewActivity"
            android:exported="true" />

        <receiver
            android:name=".DebugRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="space.zackwill.ua.DEBUG_REFRESH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
