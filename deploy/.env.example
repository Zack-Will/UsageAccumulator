# cp deploy/.env.example deploy/.env  然后填好。绝不要把填好的 .env 提交进仓库。

# Postgres
POSTGRES_USER=ua
POSTGRES_DB=ua
POSTGRES_PASSWORD=          # openssl rand -hex 24

# 看板 / 菜单栏用的单一 Bearer token（ARCHITECTURE §9，v1 不做用户体系）
UA_DASHBOARD_TOKEN=         # openssl rand -hex 32

# 探针安装时用的一次性 enroll 口令，换取长期 machine token
UA_ENROLL_TOKEN=            # openssl rand -hex 32

# Caddy 自动证书
UA_DOMAIN=ua.example.com
UA_ACME_EMAIL=you@example.com

# 菜单栏点击跳转用
UA_DASHBOARD_URL=https://ua.example.com

UA_LOG_LEVEL=info
