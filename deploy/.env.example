# cp deploy/.env.example deploy/.env  然后填好。绝不要把填好的 .env 提交进仓库。

# Postgres
POSTGRES_USER=ua
POSTGRES_DB=ua
POSTGRES_PASSWORD=          # openssl rand -hex 24

# 看板 / 菜单栏用的单一 Bearer token（ARCHITECTURE §9，v1 不做用户体系）。
# 菜单栏 App 和脚本走它；浏览器走下面的密码。
UA_DASHBOARD_TOKEN=         # openssl rand -hex 32

# 浏览器打开看板时输的密码。换台设备不用再翻上面那串随机值。
# 服务端校验后下发一张 HttpOnly 会话 Cookie（默认 30 天）。
#
# ★ 它是「记得住」的，熵比 token 低，所以服务端对登录接口做了指数退避限速
#   （见 packages/ua-server/src/login-guard.ts）。别用生日、别用其他站点的密码。
# ★ 会话签名密钥由密码派生：改了这里，所有已登录的浏览器立刻要重新登录。
# 留空 = 不开放密码登录，只剩 token 那条路。
UA_DASHBOARD_PASSWORD=

# 会话有效期（毫秒），默认 30 天
# UA_SESSION_TTL_MS=2592000000

# 探针安装时用的一次性 enroll 口令，换取长期 machine token
UA_ENROLL_TOKEN=            # openssl rand -hex 32

# Caddy 自动证书
UA_DOMAIN=ua.example.com
UA_ACME_EMAIL=you@example.com

# 菜单栏点击跳转用
UA_DASHBOARD_URL=https://ua.example.com

UA_LOG_LEVEL=info

# 服务端直接抓 claude.ai 额度（默认开）。会话在看板顶栏「额度更新」里登录，
# 存在 UA_CLAUDE_SESSION_DIR（默认 ~/.config/ua-server/claude-sessions）下的 0600 文件，不进数据库
# UA_QUOTA_SAMPLING=true
# UA_CLAUDE_SESSION_DIR=
